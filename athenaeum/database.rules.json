{
	  "rules": {
			 "Athenaeum": {
					"BGC_ID": {
						  "$bgcId": {
								 ".read": true,
								 ".write": "auth !== null"
						  }
					},
					"BUILDER_META": {
						  "$uid": {
								 ".read": "auth !== null && auth.uid === $uid",
								 ".write": "auth !== null && auth.uid === $uid"
						  }
					},
					"subject": {
						  "$sub": {
								 "content": {
										"$key": {
											  ".read": true,
											  ".write": "auth !== null"
										}
								 },
								 "download": {
										"$key": {
											  ".read": true,
											  ".write": "auth !== null"
										}
								 }
						  }
					}
			 }
	  }
}
